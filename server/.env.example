# Copy to .env. Never commit .env.
PORT=3000
NODE_ENV=development
# SQLite file path (Postgres support: swap the driver in src/db/index.ts)
DATABASE_URL=./data/staybridge.db
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated allowed browser origins (dev Vite origin). In production serve the client from this server and leave empty.
CORS_ORIGINS=http://localhost:5173
# Where uploaded files are stored (outside any static root)
UPLOAD_DIR=./uploads
# Bootstrap admin account (created on first start if no admin exists)
ADMIN_EMAIL=admin@staybridge.demo
ADMIN_PASSWORD=ChangeMe!Admin2026
# Set to "true" to insert demo owners/renters/listings on an empty database
SEED_DEMO=true

# ---- AI employees ----
# Anthropic API key. Without it the AI team is shown as "not configured" and never runs.
ANTHROPIC_API_KEY=
# Model for the AI employees
AGENT_MODEL=claude-opus-5
# How often the scheduler runs each employee (minutes). 0 disables the scheduler (manual "Run now" still works).
AGENT_INTERVAL_MINUTES=10
# Hard monthly spend cap for the AI team in USD cents; runs are skipped once reached.
AGENT_MONTHLY_BUDGET_CENTS=5000
